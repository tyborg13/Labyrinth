# Godot-specific
.import/
.godot/
*.translation
# Keep adjacent *.import and *.uid sidecars versioned. Godot 4 uses them for
# authored import settings and stable resource identities; do not ignore them.
export.cfg

# Generated builds and SteamCMD/SteamPipe working files
build/
.steam/

# OS files
.DS_Store
Thumbs.db

# IDE settings (optional)
.vscode/
.idea/

# Memento local memory
/.codex/memento/local/

# Reproducible surface-refactor render, scoring and playtest artifacts.
/output/board-surface-refactor/
/playtest/board_surface_v4_*/
/playtest/board_surface_20260906_*/
/playtest/board_surface_v5_*/

# Reproducible qa-04 repeated-suite logs and import inventories.
/output/qa-04/

# Generated cutout evidence is archived outside Git; retain editable v*/ cases.
# See spec/enemy_cutout_roster_integration.md for the verified evidence archive.
/experiments/cutouts/*/runtime*/
/experiments/cutouts/*/native*/
/experiments/cutouts/*/art_phase*/
/experiments/cutouts/*/v*/proof*/
/experiments/cutouts/*/v*/art_proof*/
/output/cutout-roster/

# Resettable Guardian feedback-pass proofs and inspection saves.
/output/guardian-revision-03/

/output/guardian-revision-04/

# Resettable full-roster contextual animation captures and authoring studies.
/output/contextual-animation-polish/

# Reproducible card targeting audit screenshots, logs and inspection saves.
/output/card-targeting-audit/

# Identity kit reference images are regenerable from canon (kit.json records their pixel digests)
spec/art_identity/jobs/**/refs/
# Maquette jobs (folders named mq*) keep their references: renders and identity paintings are provenance, not
# reconstructible canon enlargements (spec/visual_identity_gate.md §7b).
!spec/art_identity/jobs/*/mq*/refs/

# Reproducible SFX measurements, traces, PCM proof and rebuild evidence.
/output/sfx/

# Unit evidence generators (e.g. tests/el02_evidence.gd) write here; curated copies live under spec/.
/proof/

# Resettable pt13-03 renderer output; contracts and audit reports remain source.
/tests/pt13_03/**/captures/
/tests/pt13_03/**/*_manifest.json

# Offline owner-test variants; never imported or versioned.
/cel_look_variants/

# rr-48 delivery overrides the local historical Ashen Reaver experiment exclude.
!/experiments/cutouts/ashen_reaver/
/experiments/cutouts/ashen_reaver/*
!/experiments/cutouts/ashen_reaver/rr48/
!/experiments/cutouts/ashen_reaver/rr48_*.py
!/experiments/cutouts/ashen_reaver/rr48_proof.sh
!/experiments/cutouts/ashen_reaver/underlay_requests/

# rr-52 editable case; the case-local proof directory remains ignored.
!/experiments/cutouts/last_lamplighter/
/experiments/cutouts/last_lamplighter/*
!/experiments/cutouts/last_lamplighter/rr52/
!/experiments/cutouts/last_lamplighter/rr52_*.py
!/experiments/cutouts/last_lamplighter/rr52_proof.sh

# rr-56 editable Cantor case; proof remains local.
!/experiments/cutouts/storm_cantor/
/experiments/cutouts/storm_cantor/*
!/experiments/cutouts/storm_cantor/mq26/

# Proof captures and reels are local artifacts; never tracked (release 2026-11-03).
/output/
