  "version": 1,
  "creature": "storm_capacitor",
  "source_units": "source_pixels",
  "director_sha256": "24c020065a7a3acc933ba522d3ceb78877aafd71da99cbdf9b3e48624f7b72fe",
  "clips": {
    "idle": {
      "seconds": 2.0,
      "loop": true,
      "intents": [],
      "note": "still, then a buzz: the cap rattles up 1 px twice (0.1 s each) while the arcs brighten one step with it; nothing else moves"
    },
    "charge": {
      "seconds": 0.9,
      "contact": 0.5,
      "intents": [
        "charge:gain_charge"
      ],
      "note": "pressure builds: the arcs brighten in two steps while the cap climbs 3 px a pixel at a time; it rattles at the top through the contact (the existing charge VFX), then drops back with a 1 px bounce as the arcs settle"
    },
    "discharge": {
      "seconds": 1.0,
      "contact": 0.45,
      "intents": [
        "discharge:chain_discharge"
      ],
      "note": "Arc Burst: two warning rattles as the arcs flare, then the cap springs up 6 px and vents the glow at the contact (the chain lightning leaves); the spent arcs drop to dim and the cap slams back down with a 1 px bounce; the arcs recover by the end"
    },
    "hit": {
      "seconds": 0.5,
      "intents": [],
      "note": "the whole capacitor jolts 1 px back, the cap rattles twice and the arcs flash one step"
    },
    "death": {
      "seconds": 1.4,
      "terminal": true,
      "intents": [],
      "note": "a last flare blows the cap 8 px up, tipping back; it drops and lands askew (3 px up, 12 degrees back) while the arcs sputter out: dim, a flicker, dead, one weak flicker, dead; terminal pose held, then the existing fade"
    }
  },
