extends SceneTree

const Suite = preload("res://tests/suites/enemy_no_action_suite.gd")
const Callouts = preload("res://scripts/intent_callouts.gd")
const Settings = preload("res://scripts/settings_store.gd")
const Progression = preload("res://scripts/progression_store.gd")
const Run = preload("res://scripts/run_engine.gd")
# Proof/test-only setup; never production tuning.
const VIEWPORT_SIZE := Vector2i(1920, 1080)
const OUTPUT_DIR: String = "user://probes/fb-01"
const SETTLE_FRAMES: int = 8
const MID_HOLD_SECONDS: float = 0.4
const PLAYBACK_TIMEOUT_SECONDS: float = 6.0
const HOLD_SAMPLE_END_SECONDS: float = 0.78
const SECOND_ACTOR_ID: int = 2
const SECOND_ACTOR_TILE := Vector2i(6, 4)
const HIDDEN_ACTOR_TILE := Vector2i(7, 1)
const CAPTAIN_TILE := Vector2i(2, 2)
const AUDIO_DRAIN_SECONDS: float = 0.1
const GEOMETRY_SAMPLE_SECONDS: Array = [0.0, 0.4, 0.8, 1.0]
const ISOLATED_HEALTH_RECT := Rect2(500, 400, 120, 18)
const UPPER_INTENT_RECT := Rect2(500, 350, 120, 24)
var _visual_proof: bool = false
var _failures: Array[String]
var _assertions: int = 0
var _canvas: SubViewport

func _initialize() -> void:
	preload("res://scripts/parallel_runtime.gd").apply_from_environment()
	# Classic board HUD contracts (see tests/helpers/legacy_board_hud.gd).
	preload("res://tests/helpers/legacy_board_hud.gd").pin_always()
	Progression.set_storage_path("user://fb_01_profile.json")
	Progression.set_run_storage_path("user://fb_01_run.save")
	Settings.set_storage_path("user://fb_01_settings.json")
	preload("res://scripts/analytics_store.gd").set_storage_dir("user://fb_01_analytics")
	Suite.run(_expect)
	_test_anchor_geometry()
	await _test_live_playback()
	for failure: String in _failures: push_error(failure)
	print("ENEMY NO ACTION %s RESULT: %s (%d assertions; %d failures)" % ["PROBE" if _visual_proof else "TEST", "PASS" if _failures.is_empty() else "FAIL", _assertions, _failures.size()])
	quit(0 if _failures.is_empty() else 1)

func _test_live_playback() -> void:
	root.size = VIEWPORT_SIZE
	root.content_scale_size = VIEWPORT_SIZE
	root.content_scale_factor = 1.0
	if _visual_proof: DisplayServer.window_set_size(VIEWPORT_SIZE)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUTPUT_DIR))
	_canvas = SubViewport.new()
	_canvas.size = VIEWPORT_SIZE
	_canvas.msaa_2d = root.msaa_2d
	_canvas.render_target_update_mode = SubViewport.UPDATE_ALWAYS
	root.add_child(_canvas)
	var scene: Node = (load("res://scenes/run_scene.tscn") as PackedScene).instantiate()
	_canvas.add_child(scene)
	await _settle()
	scene.call("_load_run_state", Run.new().create_new_run(Suite.FIXTURE_SEED, Progression.default_data()))
	await _settle()
	var combat := Suite.Combat.new()
	for reason: String in ["out_of_range", "no_line_of_sight", "shocked", "frozen"]:
		var state: Dictionary = Suite.state_for(combat, reason)
		if reason == "frozen":
			state["enemies"][0]["is_leader"] = true
			state["enemies"][0]["pos"] = CAPTAIN_TILE
		await _install(scene, state)
		var phase: Dictionary = Suite.resolve(combat, state)
		var decorated: Array[Dictionary] = Suite.callout_steps(combat, state, phase)
		var entries: Array[Dictionary] = Suite.entries(decorated)
		_expect(entries.size() == 1, "%s proof is generated by its constructed resolver state" % reason)
		if entries.is_empty(): continue
		# Capture the live production coroutine, after any actual movement ends.
		var pacing: Node = scene.get("_combat_pacing")
		pacing.call("begin_enemies")
		var completed: Dictionary = {"hero_ready": false, "finished_usec": 0}
		_play(scene, state, phase["steps"], completed)
		var board: Control = scene.get_node("BoardUnderlay/CombatBoard") as Control
		var started: int = Time.get_ticks_usec()
		while ((board.get("presentation") as Dictionary).get("intent_callouts", []) as Array).is_empty() and not completed["hero_ready"] and float(Time.get_ticks_usec() - started) / 1000000.0 < PLAYBACK_TIMEOUT_SECONDS:
			await process_frame
		var hold_started: int = Time.get_ticks_usec()
		while float(Time.get_ticks_usec() - hold_started) / 1000000.0 < MID_HOLD_SECONDS and not completed["hero_ready"]: await process_frame
		var live: Array = (board.get("presentation") as Dictionary).get("intent_callouts", [])
		_expect(not live.is_empty() and live[0]["text"] == Suite.EXPECTED[reason] and float(live[0]["alpha"]) == 1.0, "%s capture is live, correct and mid-hold" % reason)
		var expected_caption: String = "Tunnel Crawler: %s" % (Suite.EXPECTED[reason] if reason in ["shocked", "frozen"] else str(state["enemies"][0]["intent"]["name"]))
		_expect((scene.get("action_banner") as Label).text == expected_caption, "%s proof caption agrees with the resolved turn" % reason)
		if reason == "frozen":
			# Proof-only disclosure: render the real callout with expanded intent
			# rows, without changing production playback/disclosure preferences.
			var expanded: Dictionary = (board.get("presentation") as Dictionary).duplicate(true)
			expanded["show_all_enemy_intents"] = true
			_submit_presentation(board, expanded)
			var lines: int = 0
			for hud: Dictionary in board.get("_hud_layout_entries_cache"):
				lines += (hud.get("layout", {}).get("line_rects", []) as Array).size()
			_expect(lines > 0, "Frozen proof actually shows expanded intent badges")
		_assert_hud_clearance(board, entries[0], reason)
		await _capture(reason)
		while not completed["hero_ready"] and float(Time.get_ticks_usec() - started) / 1000000.0 < PLAYBACK_TIMEOUT_SECONDS: await process_frame
		_expect(completed["hero_ready"], "%s proof playback completes" % reason)
		pacing.call("end_scope")
	if not _visual_proof: await _test_caption_playback(scene, combat)
	if not _visual_proof:
		var captain: Dictionary = Suite.state_for(combat, "frozen")
		captain["enemies"][0]["is_leader"] = true
		captain["enemies"][0]["pos"] = CAPTAIN_TILE
		await preload("res://tests/helpers/enemy_no_action_hud_observer.gd").verify(_canvas, captain, SETTLE_FRAMES, _expect)
	await _test_timing(scene, combat)
	var concealed: Dictionary = Suite.state_for(combat, "out_of_range")
	await _install(scene, concealed)
	await scene.call("_animate_enemy_phase_steps", concealed, [{"kind": "intent_callout", "actor_key": "enemy_1", "tile": Suite.ENEMY_TILE, "text": "Out of range", "no_action_reason": "out_of_range", "hidden_by_umbra": true}])
	_expect(((scene.get_node("BoardUnderlay/CombatBoard").get("presentation") as Dictionary).get("intent_callouts", []) as Array).is_empty(), "Playback also rejects explicitly concealed synthetic callouts")
	for player: Node in scene.find_children("*", "AudioStreamPlayer", true, false): player.call("stop")
	await create_timer(AUDIO_DRAIN_SECONDS, true, false, true).timeout
	_canvas.queue_free()
	await process_frame
	if _visual_proof: print(ProjectSettings.globalize_path(OUTPUT_DIR))

func _test_caption_playback(scene: Node, combat: RefCounted) -> void:
	for hidden: bool in [false, true]:
		for reason: String in ["frozen", "petrified", "shocked", "immobilized"]:
			var state: Dictionary = Suite.state_for(combat, reason)
			if hidden:
				state["umbra"] = {"stage": "heart", "light_sources": []}
				state["enemies"][0]["pos"] = HIDDEN_ACTOR_TILE
			await _install(scene, state)
			scene.call("_set_action_banner", "")
			var phase: Dictionary = Suite.resolve(combat, state)
			if hidden:
				_expect((phase["steps"] as Array).any(func(step: Dictionary) -> bool: return step.get("kind", "") == "status" and bool(step.get("hidden_by_umbra", false))), "%s privacy fixture resolves a concealed status" % reason)
			var pacing: Node = scene.get("_combat_pacing")
			pacing.call("begin_enemies")
			var completed: Dictionary = {"hero_ready": false, "finished_usec": 0}
			_play(scene, state, phase["steps"], completed)
			var banner: Label = scene.get("action_banner") as Label
			var expected: String = "Tunnel Crawler: %s" % (str(state["enemies"][0]["intent"]["name"]) if reason == "immobilized" else Suite.EXPECTED[reason])
			if not hidden and reason != "immobilized":
				_expect(banner.text == expected, "%s caption is selected before the first visible wait or movement" % reason)
			var started: int = Time.get_ticks_usec()
			var correct: bool = true
			while not completed["hero_ready"] and float(Time.get_ticks_usec() - started) / 1000000.0 < PLAYBACK_TIMEOUT_SECONDS:
				if hidden:
					correct = correct and not banner.text.contains(Suite.EXPECTED[reason]) and not banner.text.contains("Tunnel Crawler")
				elif reason != "immobilized" or str(pacing.get("_actor")) == "enemy_1":
					correct = correct and banner.text == expected
				await process_frame
			if hidden:
				correct = correct and not banner.text.contains(Suite.EXPECTED[reason]) and not banner.text.contains("Tunnel Crawler")
			_expect(completed["hero_ready"] and correct, "%s caption stays correct throughout playback (hidden=%s)" % [reason, hidden])
			if not hidden:
				_expect(banner.text == expected, "%s terminal caption matches the turn" % reason)
				if reason == "shocked": _expect(state["enemies"][0]["pos"] != Suite.ENEMY_TILE, "Shocked caption survives a real move")
			pacing.call("end_scope")

func _test_anchor_geometry() -> void:
	var font: Font = preload("res://scripts/ui_typography.gd").ui_font()
	var server: TextServer = TextServerManager.get_primary_interface()
	var rid: RID = font.get_rids()[0]
	var glyph: int = server.font_get_glyph_index(rid, Callouts.FONT_SIZE, "H".unicode_at(0), 0)
	var cap_offset: Vector2 = server.font_get_glyph_offset(rid, Vector2i(Callouts.FONT_SIZE, 0), glyph)
	var cap_size: Vector2 = server.font_get_glyph_size(rid, Vector2i(Callouts.FONT_SIZE, 0), glyph)
	var entry: Dictionary = {"text": "Shocked", "icon": "shock"}
	for intents: Array in [[], [UPPER_INTENT_RECT]]:
		var placed: Dictionary = Callouts.Layout.place(entry, ISOLATED_HEALTH_RECT, intents, [], font, Callouts.FONT_SIZE, Callouts.FloatingText.EFFECT_OUTLINE_SIZE)
		var text: Rect2 = placed["text_rect"]
		var icon: Rect2 = placed["icon_rect"]
		var anchor: float = ISOLATED_HEALTH_RECT.position.y if intents.is_empty() else UPPER_INTENT_RECT.position.y
		_expect(is_equal_approx(anchor - text.end.y, 6.0), "Text bottom sits exactly 6px above its bar or upper intent badges")
		_expect(is_equal_approx(text.get_center().x, ISOLATED_HEALTH_RECT.get_center().x), "Callout text is centred on the acting health bar")
		_expect(is_equal_approx(text.position.x - icon.end.x, 6.0), "Status icon has the director's exact 6px gap")
		_expect(is_equal_approx(icon.get_center().y, (placed["baseline"] as Vector2).y + cap_offset.y + cap_size.y * 0.5), "Status icon is vertically centred on the text cap height")
		_expect(icon.size == Vector2.ONE * cap_size.y, "Status icon retains the previously chosen cap-height size")

func _assert_hud_clearance(board: Control, entry: Dictionary, reason: String) -> void:
	var original_huds: Array = (board.get("_hud_layout_entries_cache") as Array).duplicate(true)
	var obstacles: Array[Rect2]
	var crest_count: int = 0
	for hud: Dictionary in board.get("_hud_layout_entries_cache"):
		var health: Rect2 = hud.get("health_rect", Rect2())
		if health.has_area(): obstacles.append(health)
		for rect: Rect2 in hud.get("layout", {}).get("line_rects", []): obstacles.append(rect)
		for unit: Dictionary in board.call("_hud_layout_units"):
			if str(unit.get("key", "")) != str(hud.get("actor_key", "")): continue
			var crest: Rect2 = board.call("_leader_marker_rect", unit, health, hud.get("layout", {}).get("intent_rect", Rect2()))
			if crest.has_area():
				obstacles.append(crest)
				crest_count += 1
	if reason == "frozen": _expect(crest_count > 0, "Frozen captain proof contains an actual leader crest")
	for badge: Dictionary in Callouts.Badges.layouts(board, (board.get("presentation") as Dictionary).get("threats_at_rest", {}).get("badges", [])):
		for field: String in ["rect", "order_rect"]:
			var rect: Rect2 = badge.get(field, Rect2())
			if rect.has_area(): obstacles.append(rect)
	var candidates: Array[Dictionary]
	candidates.append(entry)
	candidates.append({"text": "Redirected", "actor_key": entry["actor_key"]})
	for candidate: Dictionary in candidates:
		for reduced: bool in [false, true]:
			for elapsed: float in GEOMETRY_SAMPLE_SECONDS:
				var measured: Array[Dictionary] = Callouts.layouts(board, [Callouts.frame(candidate, elapsed, reduced)])
				_expect(measured.size() == 1, "%s: visible acting enemy has measured callout geometry" % reason)
				if measured.is_empty(): continue
				var rect: Rect2 = measured[0]["rect"]
				for obstacle: Rect2 in obstacles:
					_expect(not rect.intersects(obstacle), "%s: %s callout avoids every hero/enemy bar, intent badge and captain crest throughout its float" % [reason, candidate["text"]])
	_expect(board.get("_hud_layout_entries_cache") == original_huds, "Measuring callouts preserves the renderer's cached HUD layouts")

func _submit_presentation(board: Control, shown: Dictionary) -> void:
	board.call("set_combat_state", board.get("combat_state"), board.get("move_tiles"), board.get("attack_tiles"), board.get("selected_tile"), board.get("status_label"), board.get("status_detail"), board.get("exit_tiles"), board.get("exit_icon_ids"), shown)

func _test_timing(scene: Node, combat: RefCounted) -> void:
	for reduced: bool in [false, true]:
		var state: Dictionary = Suite.state_for(combat, "out_of_range")
		var second: Dictionary = state["enemies"][0].duplicate(true)
		second["id"] = SECOND_ACTOR_ID
		second["pos"] = SECOND_ACTOR_TILE
		state["enemies"].append(second)
		await _install(scene, state)
		var settings: Dictionary = scene.get("_settings")
		settings["combat_speed"] = Settings.COMBAT_FASTEST
		settings["reduced_motion"] = reduced
		scene.set("_settings", settings)
		var pacing: Node = scene.get("_combat_pacing")
		pacing.set("debug_timeline", true)
		pacing.call("begin_enemies")
		# An active enemy-action scope applies 0.80 * Fastest, proving that the
		# callout's wall clock is independent of both speed factors.
		pacing.call("_set_enemy_action_active", true)
		var phase: Dictionary = Suite.resolve(combat, state)
		var steps: Array = (phase["steps"] as Array).duplicate(true)
		steps.append({"kind": "intent", "actor_key": "enemy_2", "actor_name": "", "tile": SECOND_ACTOR_TILE, "intent_name": ""})
		var completed: Dictionary = {"hero_ready": false, "finished_usec": 0}
		var started: int = Time.get_ticks_usec()
		_play(scene, state, steps, completed)
		var first_frame_usec: int = 0
		var samples: int = 0
		var board: Control = scene.get_node("BoardUnderlay/CombatBoard") as Control
		while not bool(completed["hero_ready"]) and float(Time.get_ticks_usec() - started) / 1000000.0 < PLAYBACK_TIMEOUT_SECONDS:
			var entries: Array = (board.get("presentation") as Dictionary).get("intent_callouts", [])
			if not entries.is_empty():
				if first_frame_usec == 0: first_frame_usec = Time.get_ticks_usec()
				var elapsed: float = float(Time.get_ticks_usec() - first_frame_usec) / 1000000.0
				if elapsed < HOLD_SAMPLE_END_SECONDS:
					_expect(float(entries[0]["alpha"]) == 1.0, "Fastest callout remains fully opaque before 0.8 real seconds")
					_expect(not bool(completed["hero_ready"]) and not _has_second_caption(pacing), "Next enemy and hero wait throughout opaque hold")
					if reduced: _expect(entries[0]["motion_offset"] == Vector2.ZERO, "Reduced motion removes float in live playback")
					samples += 1
			await process_frame
		_expect(bool(completed["hero_ready"]) and samples > 0, "Production playback finishes and sampled the hold")
		var second_seconds: float = -1.0
		for mark: Dictionary in pacing.get("timeline"):
			if str(mark.get("actor", "")) == "enemy_2" and str(mark.get("phase", "")) == "caption": second_seconds = float(mark.get("start", -1.0))
		_expect(second_seconds >= Callouts.HOLD_SECONDS, "Next enemy caption starts after the 0.8-second hold")
		# Board focus provides an additional observable dispatch result, without
		# depending on timeline formatting to prove the next intent ran.
		var held: float = float(int(completed["finished_usec"]) - first_frame_usec) / 1000000.0
		_expect(first_frame_usec > 0 and held >= Callouts.HOLD_SECONDS, "Hero cannot become ready before 0.8 real seconds")
		_expect(((board.get("presentation") as Dictionary).get("focus_actor_keys", []) as Array).has("enemy_2"), "Next enemy intent dispatches after the reason")
		print("FB-01 FASTEST TIMING: reduced=%s observed_wait=%.3fs opaque_samples=%d" % [reduced, held, samples])
		pacing.call("end_scope")
		Engine.time_scale = 1.0

func _has_second_caption(pacing: Node) -> bool:
	for mark: Dictionary in pacing.get("timeline"):
		if str(mark.get("actor", "")) == "enemy_2": return true
	return false

func _play(scene: Node, state: Dictionary, steps: Array, completed: Dictionary) -> void:
	await scene.call("_animate_enemy_phase_steps", state, steps)
	completed["finished_usec"] = Time.get_ticks_usec()
	completed["hero_ready"] = true

func _install(scene: Node, state: Dictionary) -> void:
	var run: Dictionary = (scene.get("_run_state") as Dictionary).duplicate(true)
	run["mode"] = "combat"
	run["current_room"] = Vector2i(1, 0)
	run["current_room_layout"] = Suite.layout()
	run["combat_state"] = state.duplicate(true)
	scene.set("_run_state", run)
	scene.set("_combat_state", state.duplicate(true))
	scene.set("_animation_lock", true)
	(scene.get("_intent_callouts") as RefCounted).set("_announced", {})
	scene.call("_mark_combat_preview_state_changed")
	scene.call("_refresh_ui")
	await _settle()

func _capture(reason: String) -> void:
	if not _visual_proof: return
	_expect(is_equal_approx(root.content_scale_factor, 1.0), "Proof uses 100% UI scale")
	await RenderingServer.frame_post_draw
	var rendered: Image = _canvas.get_texture().get_image()
	_expect(rendered != null and rendered.get_size() == VIEWPORT_SIZE, "Proof uses native 1920x1080")
	if rendered != null: _expect(rendered.save_png("%s/%s_1920x1080.png" % [OUTPUT_DIR, reason]) == OK, "Save %s mid-hold" % reason)

func _settle() -> void:
	for _frame: int in range(SETTLE_FRAMES): await process_frame

func _expect(condition: bool, message: String) -> void:
	_assertions += 1
	if not condition: _failures.append(message)
