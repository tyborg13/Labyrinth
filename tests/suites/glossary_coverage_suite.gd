extends RefCounted

const Glossary = preload("res://scripts/glossary.gd")
const ActionIcons = preload("res://scripts/action_icon_library.gd")
const GameData = preload("res://scripts/game_data.gd")
const SkillTreeLibrary = preload("res://scripts/skill_tree_library.gd")
const InlineIconText = preload("res://scripts/inline_icon_text.gd")
const TokenSyntax = preload("res://scripts/inline_token_syntax.gd")
var _expect_callback: Callable
var _tokens: int = 0
var _checks: int = 0
var _one_line_tooltips: int = 0

static func run(expect: Callable) -> Dictionary:
	var suite := new()
	suite._expect_callback = expect
	suite._coverage()
	suite._one_line_card_tooltips()
	suite._token_validation_cases()
	print("GLOSSARY COVERAGE: %d entries, %d skills, %d tokens checked; %d cards scanned, %d one-line contextual tooltips" % [Glossary.all_entries().size(), SkillTreeLibrary.definitions().size(), suite._tokens, GameData.cards().size(), suite._one_line_tooltips])
	return {"checks": suite._checks, "tokens": suite._tokens}

func _coverage() -> void:
	var ids: Dictionary = {}
	var todos: Array[String]
	var raw: Array = JSON.parse_string(FileAccess.get_file_as_string(Glossary.DATA_PATH)) as Array
	_expect(raw.size() == Glossary.all_entries().size(), "Loader does not conceal duplicate ids")
	for value: Variant in Glossary.all_entries():
		var entry: Dictionary = value as Dictionary
		var id: String = str(entry.get("id", ""))
		_expect(not id.is_empty() and not ids.has(id), "Unique glossary id: " + id)
		ids[id] = true
		for field: String in ["name", "icon", "definition", "aliases"]:
			_expect(entry.has(field), id + " has " + field)
		_expect(not str(entry.get("definition", "")).strip_edges().is_empty(), "Nonempty raw definition: " + id)
		for alias: String in entry.get("aliases", []):
			_expect(str(Glossary.lookup(alias).get("id", "")) == id, "Alias resolves to its canonical concept: " + alias)
		var icon: String = str(entry.get("icon", ""))
		var text_only: bool = id in ["wait", "turns", "ice_pillar", "movement", "item", "outcrop"]
		_expect(entry["icon"] == null if text_only else (FileAccess.file_exists(icon) if icon.begins_with("res://") else not ActionIcons.icon_path(icon).is_empty()), "Approved icon exists: " + id)
		if str(entry.get("definition", "")).begins_with("TODO_DESIGN_"):
			todos.append(str(entry["definition"]))
		_check_text(entry.get("definition", ""))
		_expect(ActionIcons.description(id) == entry["definition"], "Canonical glossary definition: " + id)
	print("GLOSSARY TODO_DESIGN: %d [%s]" % [todos.size(), ", ".join(todos)])
	for key: String in ActionIcons.all_icon_keys():
		_expect(not _raw_definition(key).strip_edges().is_empty(), "Registry definition exists: " + key)
	for skill_id: String in SkillTreeLibrary.visible_ids():
		var skill: Dictionary = SkillTreeLibrary.definitions()[skill_id]
		_expect(not str(skill.get("description", "")).strip_edges().is_empty(), "Skill description exists: " + skill_id)
		_expect(ActionIcons.tooltip(str(skill["icon"])) == "%s\n%s" % [Glossary.name_for(str(skill["icon"])), Glossary.definition(str(skill["icon"]))], "Skill tooltip uses its canonical source: " + skill_id)
	for path: String in ["res://data/cards.json", "res://data/relics.json", "res://data/skills.json", "res://data/enemies.json", "res://data/grimoire.json"]:
		_walk(JSON.parse_string(FileAccess.get_file_as_string(path)))
	for card_id: String in GameData.cards():
		var card: Dictionary = GameData.card_def(card_id)
		for row: Array in ActionIcons.rows_for_card(card):
			for token: Dictionary in row:
				var key: String = str(token.get("icon", ""))
				if key == "aoe_pattern": key = "aoe"
				if not key.is_empty():
					_expect(not _raw_definition(key).strip_edges().is_empty(), card_id + " rendered token definition: " + key)
				_check_text(str(token.get("tooltip", "")))
	for enemy: Dictionary in GameData.enemies().values():
		for intent: Dictionary in enemy.get("intents", []):
			for action: Dictionary in intent.get("actions", []):
				var key: String = ActionIcons.action_icon_key(action)
				if not key.is_empty(): _expect(not _raw_definition(key).is_empty(), "Intent concept resolves: " + key)
	# Status/intent copy is generated by scripts as well as JSON; scan literal
	# @icon tokens throughout production scripts, including all badge helpers.
	_scan_scripts("res://scripts")

# A contextual heading that already occupies the tooltip's only line must not
# acquire a repeated glossary label beneath it. Scan current cards without a
# frozen count, icon order or migration baseline.
func _one_line_card_tooltips() -> void:
	for id: String in GameData.cards():
		var card: Dictionary = GameData.card_def(id)
		var leading: Array = []
		if int(card.get("time", 0)) > 0: leading.append("time")
		if ActionIcons.card_is_rite(card): leading.append("rite")
		for entry: Dictionary in ActionIcons.tooltip_entries_for_rows(ActionIcons.rows_for_card(card), leading):
			var lines: PackedStringArray = str(entry["tooltip"]).strip_edges().split("\n", false)
			if lines.size() != 1: continue
			var text: String = lines[0].strip_edges().to_lower()
			var label: String = ActionIcons.label(str(entry["icon"])).to_lower()
			if text == label or text.begins_with(label + " "):
				_one_line_tooltips += 1
				_expect(str(entry["description"]).is_empty(), "One-line contextual tooltip has zero body lines: %s (%s)" % [id, entry["icon"]])

static func _raw_definition(key: String) -> String:
	return str(Glossary.lookup(key).get("definition", ""))

func _walk(value: Variant) -> void:
	if value is Dictionary:
		for child: Variant in (value as Dictionary).values(): _walk(child)
	elif value is Array:
		for child: Variant in value: _walk(child)
	elif value is String:
		_check_text(value)

func _check_text(text: String) -> void:
	for malformed: String in TokenSyntax.malformed_tokens(text):
		_expect(false, "Malformed text token: " + malformed)
	for key: String in InlineIconText.concept_keys(text):
		_tokens += 1
		_expect(not _raw_definition(key).strip_edges().is_empty(), "Text token resolves: " + key)
	for key: String in InlineIconText.invalid_icon_keys(text):
		_expect(false, "Invalid text token: " + key)

func _token_validation_cases() -> void:
	var cases: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://tests/fixtures/inline_token_cases.json"))
	for category: String in cases:
		for markup: String in cases[category]:
			var failures: Array[String]
			var mutation := new()
			mutation._expect_callback = func(condition: bool, message: String) -> void:
				if not condition: failures.append(message)
			mutation._check_text(str(GameData.card_def("quick_stab").get("description", "")) + " " + markup)
			_expect(failures.is_empty() == (category == "valid"), "Coverage rejects unknown/malformed card text: " + markup)
			_expect(TokenSyntax.malformed_tokens(markup).is_empty() == (category != "malformed"), "Token syntax classifies malformed markup: " + markup)
			if category == "unknown":
				_expect(InlineIconText.concept_keys(markup).size() == 1 and not InlineIconText.invalid_icon_keys(markup).is_empty(), "Renderer and coverage retain punctuation/whitespace keys: " + markup)

func _scan_scripts(path: String) -> void:
	var dir := DirAccess.open(path)
	for directory: String in dir.get_directories():
		_scan_scripts(path.path_join(directory))
	for file: String in dir.get_files():
		if not file.ends_with(".gd"):
			continue
		var source: String = FileAccess.get_file_as_string(path.path_join(file))
		_check_text(source)
		if source.contains("func player_badges") or source.contains("func badges") or source.contains("func status_badges") or source.contains("func _unit_status_badges"):
			var icons := RegEx.new()
			icons.compile('"icon"\\s*:\\s*"([a-z_]+)"')
			for token: RegExMatch in icons.search_all(source):
				_tokens += 1
				_expect(not _raw_definition(token.get_string(1)).strip_edges().is_empty(), "Status badge icon resolves: " + file + ":" + token.get_string(1))

func _expect(condition: bool, message: String) -> void:
	_checks += 1
	_expect_callback.call(condition, message)
