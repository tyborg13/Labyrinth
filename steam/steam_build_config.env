# Steam build/upload configuration for scripts/build_and_upload_steam.sh
#
# Fill in the App IDs / Depot IDs from Steamworks and commit this file if you
# want the project to stay runnable without any extra local setup.

# Steam builder account used by SteamCMD. Passwords are never stored here.
STEAM_BUILDER_USERNAME="totalwarguy"

# Main game app + default branch for personal testing.
# Leave the branch as "default" if you really want the default branch.
# SteamCMD can upload the build, but Valve requires you to set default live
# manually in App Admin after the upload completes.
# Use a different depot ID for each platform in this script.
STEAM_MAIN_APP_ID=4530510
STEAM_MAIN_BRANCH="default"
STEAM_MAIN_DEPOT_MACOS=4530513
STEAM_MAIN_DEPOT_WINDOWS=4530512
STEAM_MAIN_DEPOT_LINUX=4530514

# Steam Playtest uses a separate child App ID.
# Most teams also keep this on the default branch, which likewise must be set
# live manually after upload.
# Use a different depot ID for each platform here as well.
STEAM_PLAYTEST_APP_ID=4531660
STEAM_PLAYTEST_BRANCH="default"
STEAM_PLAYTEST_DEPOT_MACOS=4531663
STEAM_PLAYTEST_DEPOT_WINDOWS=4531662
STEAM_PLAYTEST_DEPOT_LINUX=4531664

# Export/runtime names used for the generated depots and Steam launch options.
STEAM_PRODUCT_NAME="Labyrinth of Ash"
STEAM_MACOS_APP_NAME="Labyrinth of Ash.app"
STEAM_WINDOWS_EXECUTABLE_NAME="Labyrinth of Ash.exe"
STEAM_LINUX_EXECUTABLE_NAME="Labyrinth of Ash.x86_64"

# Optional overrides.
# GODOT_BINARY="/Applications/Godot.app/Contents/MacOS/Godot"
# GODOT_EXPORT_TEMPLATES_URL=""
# STEAMCMD_URL="https://steamcdn-a.akamaihd.net/client/installer/steamcmd_osx.tar.gz"
